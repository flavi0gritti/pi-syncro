{
  "name": "pi-syncro",
  "version": "1.3.0",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "peerDependencies": { "@earendil-works/pi-tui": "*", "@earendil-works/pi-coding-agent": "*" },
